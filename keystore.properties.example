# Copy to keystore.properties (git ignored) and fill in your upload key.
# Create a key with:
#   keytool -genkeypair -v -keystore ~/keystores/debuggerkit-upload.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/debuggerkit-upload.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
